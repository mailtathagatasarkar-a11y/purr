{
  "name": "purr",
  "productName": "Purr",
  "version": "0.1.0",
  "description": "Voice dictation that works in every app. Cloud or fully local. Mac + Windows.",
  "main": "./out/main/index.js",
  "author": "Tathagata Sarkar",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --no-warnings --test tests/*.test.ts",
    "build:helpers": "node scripts/build-helpers.mjs",
    "dist:win": "node scripts/build-helpers.mjs && electron-vite build && electron-builder --win",
    "dist:mac": "node scripts/build-helpers.mjs && electron-vite build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "koffi": "^3.3.3",
    "node-llama-cpp": "^3.22.1",
    "sherpa-onnx-node": "^1.13.8",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "koffi@3.3.3": true,
    "electron-winstaller@5.4.0": true,
    "node-llama-cpp@3.22.1": true,
    "uiohook-napi": false
  }
}
